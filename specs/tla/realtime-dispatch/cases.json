{
  "schema": 2,
  "model": "RealtimeDispatch",
  "defaults": {
    "capacity": 1, "stream_limit": 2, "stream_bytes": 4,
    "response_limit": 2, "response_bytes": 4, "input": "IsolationInput",
    "remote_responds": false, "writer_responds": true, "slow_route": false,
    "allow_cancel": false, "deadlines": true, "serial_client": false,
    "reject_full": true, "corrupt_replies": false, "split_epoch_key": false,
    "break_fifo": false, "skip_barrier": false
  },
  "invariants": [
    "TypeOK", "BoundedWork", "BoundedStreams", "BoundedResponses", "WriterOwnership",
    "ResponseOwnership", "ReaderOwnership", "ResponseCorrelation", "AtMostOnceReply",
    "RejectionSafety", "StreamFIFO", "StreamPrefix", "StateBarrier", "ClosedHasNoWork", "NoBlockingAdmission"
  ],
  "cases": [
    {"name":"current-isolation-1", "properties":["IOEventuallyReplies"], "expect":{"kind":"pass"}},
    {"name":"current-isolation-2", "parameters":{"capacity":2}, "properties":["IOEventuallyReplies"], "expect":{"kind":"pass"}},
    {"name":"current-relay-isolation", "parameters":{"input":"RelayInput"}, "properties":["IOEventuallyReplies"], "expect":{"kind":"pass"}},
    {"name":"current-capacity-1", "parameters":{"input":"CapacityInput"}, "properties":["IOEventuallyReplies"], "expect":{"kind":"pass"}},
    {"name":"current-capacity-2", "parameters":{"input":"CapacityInput","capacity":2}, "properties":["IOEventuallyReplies"], "expect":{"kind":"pass"}},
    {"name":"current-normal-1", "parameters":{"input":"NormalInput","remote_responds":true}, "properties":["AllRequestsResolved"], "expect":{"kind":"pass"}},
    {"name":"current-normal-2", "parameters":{"input":"NormalInput","capacity":2,"remote_responds":true}, "properties":["AllRequestsResolved"], "expect":{"kind":"pass"}},
    {"name":"current-multi-frame-order", "parameters":{"input":"MultiFrameInput","stream_limit":4}, "properties":["IOEventuallyReplies"], "expect":{"kind":"pass"}},
    {"name":"current-slow-route", "parameters":{"input":"MultiFrameInput","stream_limit":4,"slow_route":true}, "extra_invariants":["SessionOpen"], "properties":["HealthyIO"], "expect":{"kind":"pass"}},
    {"name":"current-full-key-isolation", "parameters":{"input":"KeyInput","stream_limit":4,"slow_route":true}, "extra_invariants":["SessionOpen"], "properties":["HealthyIO"], "expect":{"kind":"pass"}},
    {"name":"current-slow-write", "parameters":{"writer_responds":false,"remote_responds":true}, "properties":["IOCompletedOrFailed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"slow-write-does-not-guarantee-pong", "parameters":{"writer_responds":false}, "properties":["IOEventuallyReplies"], "expect":{"kind":"temporal","name":"IOEventuallyReplies"}},
    {"name":"without-deadline-no-progress", "parameters":{"writer_responds":false,"deadlines":false}, "properties":["IOCompletedOrFailed"], "expect":{"kind":"temporal","name":"IOCompletedOrFailed"}},
    {"name":"current-state-barrier", "parameters":{"input":"StateInput"}, "properties":["IOEventuallyReplies"], "expect":{"kind":"temporal","name":"IOEventuallyReplies"}},
    {"name":"current-stream-state-barrier", "parameters":{"input":"StreamBarrierInput","slow_route":true}, "properties":["IOEventuallyReplies"], "expect":{"kind":"temporal","name":"IOEventuallyReplies"}},
    {"name":"current-response-state-barrier", "parameters":{"input":"ResponseBarrierInput","writer_responds":false}, "properties":["IOCompletedOrFailed"], "expect":{"kind":"pass"}},
    {"name":"current-client-serial-normal", "parameters":{"serial_client":true,"remote_responds":true,"input":"NormalInput"}, "properties":["AllRequestsSuccessful"], "expect":{"kind":"pass"}},
    {"name":"current-client-serial-slow", "parameters":{"serial_client":true}, "properties":["IOEventuallyReplies"], "expect":{"kind":"temporal","name":"IOEventuallyReplies"}},
    {"name":"current-cancel-pending", "parameters":{"allow_cancel":true}, "properties":["ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-cancel-capacity-2", "parameters":{"allow_cancel":true,"capacity":2,"input":"CapacityInput"}, "properties":["ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-cancel-slow-route", "parameters":{"allow_cancel":true,"slow_route":true,"input":"StreamOverflowInput"}, "properties":["ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-cancel-blocked-write", "parameters":{"allow_cancel":true,"writer_responds":false,"remote_responds":true,"deadlines":false}, "properties":["ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-idle-cancel", "parameters":{"input":"EmptyInput","allow_cancel":true}, "properties":["ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-stream-items", "parameters":{"input":"StreamOverflowInput","slow_route":true}, "properties":["EventuallyClosed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-stream-bytes", "parameters":{"input":"StreamByteInput","stream_bytes":2,"slow_route":true}, "properties":["EventuallyClosed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-response-items", "parameters":{"input":"ResponseOverflowInput","writer_responds":false,"deadlines":false}, "properties":["EventuallyClosed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-response-bytes", "parameters":{"input":"ResponseByteInput","response_bytes":2,"writer_responds":false,"deadlines":false}, "properties":["EventuallyClosed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-stream-capacity-1", "parameters":{"input":"StreamOverflowInput","stream_limit":1,"slow_route":true}, "properties":["EventuallyClosed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"current-reject-response-overflow", "parameters":{"input":"CapacityInput","response_limit":1,"writer_responds":false,"deadlines":false}, "properties":["EventuallyClosed","ClosingDrains"], "expect":{"kind":"pass"}},
    {"name":"witness-isolated-progress", "extra_invariants":["NoIsolationWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoIsolationWitness"}},
    {"name":"witness-rejected-request", "parameters":{"input":"CapacityInput"}, "extra_invariants":["NoRejectedWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoRejectedWitness"}},
    {"name":"witness-healthy-without-close", "parameters":{"input":"MultiFrameInput","stream_limit":4,"slow_route":true}, "extra_invariants":["NoHealthyWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoHealthyWitness"}},
    {"name":"witness-full-key-without-close", "parameters":{"input":"KeyInput","stream_limit":4,"slow_route":true}, "extra_invariants":["NoHealthyWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoHealthyWitness"}},
    {"name":"witness-cross-key-overtake", "parameters":{"input":"MultiFrameInput","stream_limit":4,"slow_route":true}, "extra_invariants":["NoCrossKeyWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoCrossKeyWitness"}},
    {"name":"witness-multi-frame-epochs", "parameters":{"input":"MultiFrameInput","stream_limit":4}, "extra_invariants":["NoMultiFrameWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoMultiFrameWitness"}},
    {"name":"witness-cancel-pending", "parameters":{"allow_cancel":true}, "extra_invariants":["NoCancelWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoCancelWitness"}},
    {"name":"witness-cancel-writer", "parameters":{"allow_cancel":true,"writer_responds":false,"remote_responds":true,"deadlines":false}, "extra_invariants":["NoCancelWriterWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoCancelWriterWitness"}},
    {"name":"witness-cancel-route", "parameters":{"allow_cancel":true,"slow_route":true,"input":"StreamOverflowInput"}, "extra_invariants":["NoCancelRouteWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoCancelRouteWitness"}},
    {"name":"witness-write-failure", "parameters":{"allow_cancel":true,"remote_responds":true}, "extra_invariants":["NoWriteFailureWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoWriteFailureWitness"}},
    {"name":"witness-idle-cancel", "parameters":{"input":"EmptyInput","allow_cancel":true}, "extra_invariants":["NoIdleCancelWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoIdleCancelWitness"}},
    {"name":"witness-deadline", "parameters":{"writer_responds":false}, "extra_invariants":["NoDeadlineWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoDeadlineWitness"}},
    {"name":"witness-lock-wait-deadline", "parameters":{"writer_responds":false,"remote_responds":true}, "extra_invariants":["NoLockDeadlineWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoLockDeadlineWitness"}},
    {"name":"witness-stream-items", "parameters":{"input":"StreamOverflowInput","slow_route":true}, "extra_invariants":["NoStreamItemsWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoStreamItemsWitness"}},
    {"name":"witness-stream-bytes", "parameters":{"input":"StreamByteInput","stream_bytes":2,"slow_route":true}, "extra_invariants":["NoStreamBytesWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoStreamBytesWitness"}},
    {"name":"witness-response-items", "parameters":{"input":"ResponseOverflowInput","writer_responds":false,"deadlines":false}, "extra_invariants":["NoResponseItemsWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoResponseItemsWitness"}},
    {"name":"witness-response-bytes", "parameters":{"input":"ResponseByteInput","response_bytes":2,"writer_responds":false,"deadlines":false}, "extra_invariants":["NoResponseBytesWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoResponseBytesWitness"}},
    {"name":"witness-active-response-counted", "parameters":{"input":"ResponseOverflowInput","writer_responds":false,"deadlines":false}, "extra_invariants":["NoActiveResponseWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoActiveResponseWitness"}},
    {"name":"witness-state-completed", "parameters":{"input":"NormalInput","remote_responds":true}, "extra_invariants":["NoBarrierWitness"], "properties":[], "expect":{"kind":"invariant","name":"NoBarrierWitness"}},
    {"name":"mutation-response-correlation", "parameters":{"corrupt_replies":true}, "properties":[], "expect":{"kind":"invariant","name":"ResponseCorrelation"}},
    {"name":"mutation-rejected-correlation", "parameters":{"input":"CapacityInput","corrupt_replies":true}, "properties":[], "expect":{"kind":"invariant","name":"ResponseCorrelation"}},
    {"name":"mutation-epoch-key", "parameters":{"input":"MultiFrameInput","stream_limit":4,"split_epoch_key":true}, "omit_invariants":["StreamFIFO"], "properties":[], "expect":{"kind":"invariant","name":"StreamPrefix"}},
    {"name":"mutation-stream-fifo", "parameters":{"input":"MultiFrameInput","stream_limit":4,"break_fifo":true}, "omit_invariants":["StreamFIFO"], "properties":[], "expect":{"kind":"invariant","name":"StreamPrefix"}},
    {"name":"mutation-background-barrier", "parameters":{"input":"StateInput","skip_barrier":true}, "properties":[], "expect":{"kind":"invariant","name":"StateBarrier"}},
    {"name":"mutation-stream-barrier", "parameters":{"input":"StreamBarrierInput","slow_route":true,"skip_barrier":true}, "properties":[], "expect":{"kind":"invariant","name":"StateBarrier"}},
    {"name":"mutation-response-barrier", "parameters":{"input":"ResponseBarrierInput","skip_barrier":true}, "properties":[], "expect":{"kind":"invariant","name":"StateBarrier"}},
    {"name":"mutation-blocking-admission", "parameters":{"input":"CapacityInput","reject_full":false}, "properties":[], "expect":{"kind":"invariant","name":"NoBlockingAdmission"}}
  ]
}
